{
  "$defs": {
    "Cell": {
      "properties": {
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "display_value": {
          "default": "",
          "title": "Display Value",
          "type": "string"
        },
        "status": {
          "enum": [
            "stated",
            "inferred",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "entity_id",
        "status",
        "confidence"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Entity": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "is_your_company": {
          "title": "Is Your Company",
          "type": "boolean"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "is_your_company",
        "source_id"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "description": "verbatim substring of the source",
          "title": "Quote",
          "type": "string"
        },
        "start_char": {
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "title": "End Char",
          "type": "integer"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "quote",
        "start_char",
        "end_char"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FieldDefinition": {
      "properties": {
        "id": {
          "description": "stable snake_case key",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "price",
            "number",
            "list",
            "categorical",
            "boolean",
            "free_text"
          ],
          "title": "Type",
          "type": "string"
        },
        "comparison_rule": {
          "enum": [
            "lower_is_better",
            "higher_is_better",
            "presence_is_better",
            "qualitative_llm",
            "not_compared"
          ],
          "title": "Comparison Rule",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "extraction guidance shown to the model",
          "title": "Description",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "industry_presets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Industry Presets",
          "type": "array"
        },
        "custom": {
          "default": false,
          "title": "Custom",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "comparison_rule"
      ],
      "title": "FieldDefinition",
      "type": "object"
    },
    "Source": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "entity_id",
        "text"
      ],
      "title": "Source",
      "type": "object"
    },
    "Verdict": {
      "properties": {
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "entity_id": {
          "description": "the competitor being compared to your company",
          "title": "Entity Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "win",
            "lose",
            "tie",
            "n/a"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "method": {
          "default": "rule",
          "enum": [
            "rule",
            "llm"
          ],
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "field_id",
        "entity_id",
        "verdict"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "meta": {
      "additionalProperties": true,
      "default": {},
      "title": "Meta",
      "type": "object"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldDefinition"
      },
      "title": "Fields",
      "type": "array"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/Cell"
      },
      "title": "Cells",
      "type": "array"
    },
    "verdicts": {
      "items": {
        "$ref": "#/$defs/Verdict"
      },
      "title": "Verdicts",
      "type": "array"
    }
  },
  "required": [
    "id",
    "entities",
    "sources",
    "fields",
    "cells",
    "verdicts"
  ],
  "title": "Comparison",
  "type": "object"
}
