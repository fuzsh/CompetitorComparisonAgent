{
  "properties": {
    "id": {
      "description": "stable snake_case key",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "type": {
      "enum": [
        "price",
        "number",
        "list",
        "categorical",
        "boolean",
        "free_text"
      ],
      "title": "Type",
      "type": "string"
    },
    "comparison_rule": {
      "enum": [
        "lower_is_better",
        "higher_is_better",
        "presence_is_better",
        "qualitative_llm",
        "not_compared"
      ],
      "title": "Comparison Rule",
      "type": "string"
    },
    "description": {
      "default": "",
      "description": "extraction guidance shown to the model",
      "title": "Description",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "industry_presets": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Industry Presets",
      "type": "array"
    },
    "custom": {
      "default": false,
      "title": "Custom",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "label",
    "type",
    "comparison_rule"
  ],
  "title": "FieldDefinition",
  "type": "object"
}
