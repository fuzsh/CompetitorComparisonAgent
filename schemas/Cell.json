{
  "$defs": {
    "Evidence": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "description": "verbatim substring of the source",
          "title": "Quote",
          "type": "string"
        },
        "start_char": {
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "title": "End Char",
          "type": "integer"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "quote",
        "start_char",
        "end_char"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "properties": {
    "field_id": {
      "title": "Field Id",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "display_value": {
      "default": "",
      "title": "Display Value",
      "type": "string"
    },
    "status": {
      "enum": [
        "stated",
        "inferred",
        "missing"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "field_id",
    "entity_id",
    "status",
    "confidence"
  ],
  "title": "Cell",
  "type": "object"
}
