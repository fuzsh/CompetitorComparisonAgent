# Model backend = headless Claude Code session (`claude -p`). No API key needed; run `claude` once and log in.
# CLAUDE_MODEL=sonnet          # optional; defaults to your Claude Code session default
# CLAUDE_TIMEOUT=300           # seconds per model call

# Optional Jev attachment (TypeSafe). When set: semantic quote-support check runs after verification.
# TYPESAFE_API_KEY=...
# JEV_SUPPORT_CHECK=1          # 0 to disable the support check
# EXTRACTOR=claude|jev         # jev = select-not-generate extraction fallback
# JUDGE=claude|jev             # jev = calibrated Choice judgments for qualitative rows

# CORS_ORIGINS=http://localhost:3000
